[flake8]
max-line-length = 120

# No autoformatter is configured for this project: the codebase aligns related assignments by hand
# (~260 lines), which black would collapse. Enforcing pycodestyle's layout rules would fight that
# same style from the other direction, so they are not enabled.
#
# What is kept is the part that finds real problems rather than layout opinions:
#   F   pyflakes        — undefined names, unused imports, unused variables
#   B   bugbear         — likely bugs, e.g. mutable default arguments
#   C   comprehensions  — comprehensions written as slower or less clear calls
#   E9  syntax errors and indentation errors that break parsing
select = F,B,C,E9

# C408 objects to `dict(a=1)` in favour of `{"a": 1}`. That is a preference, not a defect, and the
# keyword form reads better for the wide option dicts the plotting code passes around.
extend-ignore = C408

per-file-ignores =
    # Submodules imported so `import cntp` exposes the whole namespace; not referenced in the file.
    cntp/__init__.py:F401
